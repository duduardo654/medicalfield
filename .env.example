# ===== MedicalField - configuração (copie para .env: scripts/setup-env.sh faz isso) =====
# Banco central PostgreSQL
DATABASE_URL=postgresql://medicalfield:CHANGE_ME@localhost:5432/medicalfield
# Segredo compartilhado para assinar/validar JWT (HS256) - gerado pelo setup-env.sh
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_MINUTES=480
# Portas
AUTH_PORT=8001
CORE_PORT=8002
BUSINESS_PORT=8003
APP_PORT=3000
# URLs usadas na comunicação entre serviços / front-ends
AUTH_URL=http://localhost:8001
CORE_URL=http://localhost:8002
BUSINESS_URL=http://localhost:8003
# SMTP real: configure as variáveis abaixo no arquivo .env local, sem versionar senhas.
# A conta Google Workspace precisa permitir SMTP com senha de app.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM=eduardo.secco@universo.univates.br
SMTP_USER=eduardo.secco@universo.univates.br
SMTP_PASS=
# Logs
LOG_DIR=./logs
ENABLE_DOCS=true
# Estratégia padrão de resolução de conflitos na sincronização:
# LAST_WRITE_WINS | SERVER_WINS | FIELD_MERGE
CONFLICT_STRATEGY=LAST_WRITE_WINS
# Cliente SQLite: por padrão applications/attendance-client/data/medicalfield.sqlite3
# CLIENT_DB_PATH=C:/MedicalField/medicalfield.sqlite3
