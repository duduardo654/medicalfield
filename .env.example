# ===== MedicalField - configuração (copie para .env: scripts/setup-env.sh faz isso) =====
# Banco central PostgreSQL
DATABASE_URL=postgresql://medicalfield:CHANGE_ME@localhost:5432/medicalfield
# Segredo compartilhado para assinar/validar JWT (HS256) - gerado pelo setup-env.sh
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_MINUTES=480
# Portas
AUTH_PORT=8001
CORE_PORT=8002
BUSINESS_PORT=8003
ADMIN_PORTAL_PORT=3000
CLIENT_PORT=3001
# URLs usadas na comunicação entre serviços / front-ends
AUTH_URL=http://localhost:8001
CORE_URL=http://localhost:8002
BUSINESS_URL=http://localhost:8003
# SMTP de testes (Mailpit: SMTP 1025, interface web 8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=fichas@medicalfield.test
# Logs
LOG_DIR=./logs
ENABLE_DOCS=true
